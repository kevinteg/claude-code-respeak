# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# sibling: every hit below is the plugin's own name (`respeak`); no other sibling
# appears outside design/ and history/. One glob per directory.
.claude-plugin/*: sibling,person
plugin/.claude-plugin/*: sibling,person
.claude/respeak/*: sibling
.gitignore: sibling
.python-version: sibling
CHANGELOG.md: sibling
CLAUDE.md: sibling
Makefile: sibling
plugin/agents/*: sibling
assets/*: sibling
plugin/config/*: sibling
plugin/corpus/*: sibling
plugin/corpus/style/*: sibling
docs/*: sibling
plugin/docs/*: sibling
examples/layered/*: sibling
examples/layered/home/.claude/respeak/*: sibling
examples/layered/project/.claude/respeak/*: sibling
# The folder fixtures' file name is the plugin's own (`.respeak.yaml`); the scan reads path names.
examples/layered/project/docs/api/*: sibling
examples/layered/project/docs/exec/*: sibling
examples/layered/project/notes/*: sibling
plugin/hooks/*: sibling
research/sources/*: sibling,email
research/synthesis/*: sibling
scripts/*: sibling
plugin/scripts/*: sibling,email
plugin/skills/*/*: sibling
tests/*: sibling,lan,email
.hygiene-allow: sibling
# email: a comment's SSH URL form (plugin/scripts), fixture addresses (tests), a quoted
# example address (research/sources). lan: the fixture's `.local(` method (tests).
# person: the author (LICENSE, the manifests' author and owner) and the repo URL.
LICENSE: person
README.md: sibling,person
# design/readme/: the README's source; the plugin's name and the repo URL in the install lines.
design/readme/*: sibling,person
# The packets and the relay rows name the siblings, the builders' paths and the owner.
design/packets/*: sibling,home,person
history/sittings/*.md: private
design/review-r6.md: sibling
