{
  "description": "respeak: lexicon status at session start; optional milestone auto-narrative; opt-in style gate on Write/Edit of markdown",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/lexicon-status.sh\"",
            "timeout": 10,
            "statusMessage": "respeak: reading lexicon status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop-narrative.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/respeak-gate.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
